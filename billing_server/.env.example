# Copy to .env and fill in real values. NEVER commit the real .env.
#
# Node 20.6+ can load it directly:
#   node --env-file=.env src/index.js
#
# Or let your platform (Cloud Run, ECS, Fly.io, systemd) inject these.
# The service refuses to start if any of the first four is missing.

PORT=8080

# Comma-separated. Supports two values during key rotation.
TRACK_BILLING_API_KEYS=replace-with-a-long-random-key

# Bearer token that Google Cloud Pub/Sub must present on POST /rtdn.
TRACK_RTDN_SECRET=replace-with-another-long-random-key

# Google Play Developer API service-account credentials. Use ONE of the two:
#   1) GOOGLE_APPLICATION_CREDENTIALS — path to a mounted secret file (preferred
#      when mounting a Railway secret file or a volume-mounted key).
#   2) GOOGLE_APPLICATION_CREDENTIALS_JSON — the entire service-account JSON as a
#      single-line string. Easiest for Railway variable injection; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...paste key JSON...}

# Persistent JSON store. In the Docker image this defaults to /data/purchases.json.
# Keep this inside the Railway Volume mounted at /data.
TRACK_STORE_PATH=/data/purchases.json

# Optional: per-request socket timeout in milliseconds (default 30000).
# Bounds how long a client may hold a connection open (slowloris defense).
TRACK_REQUEST_TIMEOUT_MS=30000
