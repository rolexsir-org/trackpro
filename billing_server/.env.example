# Copy to .env and fill in real values. NEVER commit the real .env.
#
# Node 20.6+ can load it directly:
#   node --env-file=.env src/index.js
#
# Or let your platform (Cloud Run, ECS, Fly.io, systemd) inject these.
# The service refuses to start if any of the first four is missing.

PORT=8080

# Comma-separated. Supports two values during key rotation.
TRACK_BILLING_API_KEYS=replace-with-a-long-random-key

# Bearer token that Google Cloud Pub/Sub must present on POST /rtdn.
TRACK_RTDN_SECRET=replace-with-another-long-random-key

# Path to the Play Developer API service-account JSON key.
# Mount it as a secret; do not bake it into the image.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-service-account.json

# Persistent JSON store. In the Docker image this defaults to /data/purchases.json.
TRACK_STORE_PATH=/data/purchases.json
