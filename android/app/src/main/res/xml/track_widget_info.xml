<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget metadata for the Glance widget in TrackWidget.kt.

  updatePeriodMillis is deliberately large: the widget is refreshed explicitly by
  the app after every write (track/widget channel → TrackWidget.refresh), so the
  system-driven refresh only exists as a safety net for a device that has been
  asleep for a long time.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="160dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/track_widget_description"
    android:previewImage="@mipmap/ic_launcher"
    android:updatePeriodMillis="1800000" />
